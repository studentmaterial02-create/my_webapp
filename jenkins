pipeline {
    
    agent {
        any 
    }

    environment {

        IMAGE_NAME = "parkar05/my_webapp" 
        DOCKERHUB_CREDENITIALS = credentials('Dockerhub CD') 
        
        IMAGE_TAG = "${env.BUILD_NUMBER}" 
        DOCKER_REGISTRY = "https://index.docker.io/v1/"
        GIT_URL = "https://github.com/studentmaterial02-create/my_webapp.git"
    }

    stages {
      
        stage('Source Checkout') {
            steps {
                // Retrieves the source code. Uses the credential ID 'docker ID' 
                git branch: 'main',
                    credentialsId: 'dockerid ID', 
                    url: env.GIT_URL
            }
        }

        stage('Build and Tag Docker Image') {
            steps {
                script {
                    def dockerImage = docker.build("${env.IMAGE_NAME}:${env.IMAGE_TAG}", ".")
                    
                    echo "Successfully built Docker image: ${env.IMAGE_NAME}:${env.IMAGE_TAG}"
                    
                    env.DOCKER_IMAGE_OBJECT = dockerImage.id
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                withRegistry(env.DOCKER_REGISTRY, env.DOCKERHUB_CREDENITIALS) {
                    
                    docker.image("${env.IMAGE_NAME}").push("${env.IMAGE_TAG}")
                    
                    docker.image("${env.IMAGE_NAME}").push("latest") 
                }
            }
        }
    }

    
    post {
        always {
            echo 'Clearing up workspace...'
            deleteDir()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
